# Agent dashboard (lfad) daemon config. Copy to `.env` and adjust.
# Precedence: CLI flag > .env (these vars) > built-in default.
# Variables are named LFAD_*. Older .env files that use HITLOOP_* still work:
# each HITLOOP_ name is read when its LFAD_ name is unset.
# Relative paths resolve against the directory you run `flow` / `pnpm demo` from
# (the tool root), so `..` means the managed project.

# Port the daemon binds (the UI talks to /api on the same origin).
LFAD_PORT=4319

# The ticket board this daemon manages. Two supported layouts:
#   in-board (canonical): tool at <project>/.agent-dashboard/.lfad  ->  LFAD_BOARD=..
#   sibling:              tool at <project>/lfad                     ->  LFAD_BOARD=../.agent-dashboard (default)
# Boards set up before the rename live in <project>/.flow with the tool in .flow/.hitloop.
LFAD_BOARD=../.agent-dashboard

# Built UI to serve at /. OPTIONAL OVERRIDE. Leave unset: the daemon copies the
# tool's built UI into `<board>/.ui` (gitignored) on serve and serves from there,
# so the board folder is self-contained. Set only to serve a custom UI build.
# LFAD_UI_DIR=packages/ui/dist

# Where a Document step writes knowledge docs. Leave unset to keep them inside
# the board (<board>/chunks and <board>/session); set these to relocate them
# OUTSIDE the board — e.g. into the managed project's existing docs tree:
# LFAD_DOCS_CHUNKS=../.readme/chunks
# LFAD_DOCS_SESSIONS=../.readme/session

# ── Headless run engine (DORMANT) ────────────────────────────────────────────
# The vars below configure the headless run engine ONLY. It is dormant: the
# board UI never triggers runs — step buttons copy `/flow:<skill> <id>` for you
# to paste into your own Claude Code session. The engine is kept in the codebase
# (routes + RunManager) and can still be driven directly over REST, but nothing
# here affects the board itself. Leave them unset unless you drive runs by hand.
#
# BREAKING: HITLOOP_AGENT_CMD and HITLOOP_PERMISSION_MODE were REMOVED. Which
# CLI runs a step (cmd/args/model/effort — and any permission flag) is now
# per-board data: the `agents` section of <board>/board.yml. See
# docs/board.example.yml for the full adapter schema.

# The git repo the agent edits. UNSET (default) ⇒ runs are doc/dry-run only.
# Relative paths resolve against the board root.
# LFAD_CODE_REPO=../main

# Where per-ticket worktrees go (default `<codeRepo>/../.hitloop-worktrees`).
# Worktrees are created via `flow worktree create <id> --branch <name>` (or the
# REST equivalent) — skills decide when and with what branch name.
# LFAD_WORKTREE_ROOT=../.hitloop-worktrees

# v1 safety rail: when true the daemon makes no code-repo commit and tells the
# agent not to commit. Default true. Set to false to let runs touch code.
# LFAD_DRY_RUN=true

# After a step completes cleanly, advance and keep running the next agent-work
# step until a human-gate / blocked / done / timeout. Default true.
# LFAD_AUTOPILOT=true

# Hard per-run wall-clock limit in ms (default 600000 = 10 min). On timeout the
# child is killed and the run is marked errored.
# LFAD_RUN_TIMEOUT_MS=600000
