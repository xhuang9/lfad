{
  "name": "local-filebased-agent-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "deploy": "node scripts/deploy.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "bootstrap": "node scripts/setup.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
